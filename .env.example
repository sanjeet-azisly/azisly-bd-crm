# Copy to .env.local (for your Mac) and add the same values in Vercel.

# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → Session pooler connection string (with your database password).
# Only needed on your Mac to set up the database tables.
DATABASE_URL=

# Where the app lives (http://localhost:3000 on your Mac; your Vercel address when live)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The first admin account created by `npm run db:seed`
ADMIN_EMAIL=sanjeet@azisly.ai
ADMIN_NAME=Sanjeet
